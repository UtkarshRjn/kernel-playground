# ---- Database (Postgres) ----
# Neon/Supabase pooled connection string for the app:
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Direct (non-pooled) connection for migrations (Neon/Supabase). Optional but recommended:
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# ---- Auth.js ----
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Set to your deployed URL in production (e.g. https://your-app.vercel.app)
AUTH_URL="http://localhost:3000"
# GitHub OAuth app (Settings → Developer settings → OAuth Apps)
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
# Google OAuth client (Google Cloud Console → Credentials)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ---- Analytics (PostHog) ----
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# ---- Execution backend (Modal HTTP endpoint) ----
# When both are set the run pipeline uses real GPUs; otherwise the deterministic mock.
EXECUTION_API_URL=""
EXECUTION_TOKEN=""

# ---- Cost guardrails (platform-wide, independent of per-user credits) ----
# Manual kill switch: "1" rejects every new run.submit with "GPU capacity paused for today".
KP_RUNS_DISABLED=""
# Reject new runs once trailing-24h GPU spend (settled cost + in-flight holds) reaches this (USD). Default 25.
KP_DAILY_SPEND_LIMIT_USD="25"
# Daily cron (/api/cron/spend-report) posts to the webhook when 24h spend reaches this (USD). Default 10.
KP_SPEND_ALERT_USD="10"
# Slack or Discord incoming-webhook URL for spend alerts.
KP_ALERT_WEBHOOK_URL=""
# Vercel Cron sends `Authorization: Bearer $CRON_SECRET`. Generate with: openssl rand -hex 32
CRON_SECRET=""
