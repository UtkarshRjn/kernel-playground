# ---- Database (Postgres) ----
# Neon/Supabase pooled connection string for the app:
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Direct (non-pooled) connection for migrations (Neon/Supabase). Optional but recommended:
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# ---- Auth.js ----
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Set to your deployed URL in production (e.g. https://your-app.vercel.app)
AUTH_URL="http://localhost:3000"
# GitHub OAuth app (Settings → Developer settings → OAuth Apps)
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
# Google OAuth client (Google Cloud Console → Credentials)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ---- Starter credits (1 credit = $0.01) ----
# Free credits granted once, at a user's first sign-in. Default 200 ($2); 0 disables.
KP_STARTER_CREDITS="200"
# GitHub sign-ins only get starter credits if the GitHub account is at least this
# many days old (default 30; 0 disables the check). Google sign-ins need a verified email.
# Ineligible users can still sign in; they just start with 0 credits.
KP_MIN_GITHUB_ACCOUNT_AGE_DAYS="30"

# ---- Analytics (PostHog) ----
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# ---- Execution backend (Modal HTTP endpoint) ----
# When both are set the run pipeline uses real GPUs. If either is missing:
#   - development / test: falls back to the deterministic mock backend
#   - production (VERCEL_ENV=production or NODE_ENV=production): requests fail with a
#     config error instead of serving fake benchmark numbers (checked at first request,
#     so `next build` without these vars still works)
EXECUTION_API_URL=""
EXECUTION_TOKEN=""
# Set to "1" to explicitly allow the mock backend in production-like envs (e.g. a Vercel
# preview or staging without GPUs). Results are labeled "Simulated results" in the UI.
# Leave unset in real production.
KP_ALLOW_MOCK_PROVIDER=""

# ---- GPU tiers ----
# Everyone is limited to "free"-tier GPUs (no paid plan yet). Comma-separated user ids
# and/or emails listed here get every tier (standard + premium, e.g. H100/B200).
KP_PREMIUM_USER_IDS=""

# ---- Rate limits / concurrency caps (optional; defaults shown; 0 blocks the action) ----
# run.test (free compile check, but each call starts a Modal CPU container), per user:
RATE_LIMIT_TEST_PER_MINUTE="30"
RATE_LIMIT_TEST_PER_DAY="300"
# run.submit (GPU runs): submits per user per trailing hour
RATE_LIMIT_SUBMIT_PER_HOUR="20"
# Max queued|running runs per user, and across all users
MAX_ACTIVE_RUNS_PER_USER="2"
MAX_ACTIVE_RUNS_GLOBAL="20"

# ---- Stuck-run sweeper (Vercel Cron → /api/cron/sweep-runs) ----
# Vercel Cron sends `Authorization: Bearer $CRON_SECRET`. Required: the route returns 401
# when unset. Generate with: openssl rand -hex 32
CRON_SECRET=""
# Seconds a run may stay queued/running before it's failed and its credit hold released.
# Default 900 (15 min); values below 840 are clamped up (must exceed the 800s maxDuration).
RUN_STALE_AFTER_SEC="900"

# ---- Cost guardrails (platform-wide, independent of per-user credits) ----
# Manual kill switch: "1" rejects every new run.submit with "GPU capacity paused for today".
KP_RUNS_DISABLED=""
# Reject new runs once trailing-24h GPU spend (settled cost + in-flight holds) reaches this (USD). Default 25.
KP_DAILY_SPEND_LIMIT_USD="25"
# Daily cron (/api/cron/spend-report) posts to the webhook when 24h spend reaches this (USD). Default 10.
KP_SPEND_ALERT_USD="10"
# Slack or Discord incoming-webhook URL for spend alerts.
KP_ALERT_WEBHOOK_URL=""
# Cron auth uses CRON_SECRET (see the stuck-run sweeper section above).
