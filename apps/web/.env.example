# ---- Database (Postgres) ----
# Neon/Supabase pooled connection string for the app:
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Direct (non-pooled) connection for migrations (Neon/Supabase). Optional but recommended:
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# ---- Auth.js ----
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Set to your deployed URL in production (e.g. https://your-app.vercel.app)
AUTH_URL="http://localhost:3000"
# GitHub OAuth app (Settings → Developer settings → OAuth Apps)
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
# Google OAuth client (Google Cloud Console → Credentials)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ---- Starter credits (1 credit = $0.01) ----
# Free credits granted once, at a user's first sign-in. Default 200 ($2); 0 disables.
KP_STARTER_CREDITS="200"
# GitHub sign-ins only get starter credits if the GitHub account is at least this
# many days old (default 30; 0 disables the check). Google sign-ins need a verified email.
# Ineligible users can still sign in; they just start with 0 credits.
KP_MIN_GITHUB_ACCOUNT_AGE_DAYS="30"

# ---- Analytics (PostHog) ----
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# ---- Execution backend (Modal HTTP endpoint) ----
# When both are set the run pipeline uses real GPUs; otherwise the deterministic mock.
EXECUTION_API_URL=""
EXECUTION_TOKEN=""

# ---- GPU tiers ----
# Everyone is limited to "free"-tier GPUs (no paid plan yet). Comma-separated user ids
# and/or emails listed here get every tier (standard + premium, e.g. H100/B200).
KP_PREMIUM_USER_IDS=""

# ---- Rate limits / concurrency caps (optional; defaults shown; 0 blocks the action) ----
# run.test (free compile check, but each call starts a Modal CPU container), per user:
RATE_LIMIT_TEST_PER_MINUTE="30"
RATE_LIMIT_TEST_PER_DAY="300"
# run.submit (GPU runs): submits per user per trailing hour
RATE_LIMIT_SUBMIT_PER_HOUR="20"
# Max queued|running runs per user, and across all users
MAX_ACTIVE_RUNS_PER_USER="2"
MAX_ACTIVE_RUNS_GLOBAL="20"
